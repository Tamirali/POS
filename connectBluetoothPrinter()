async function connectBluetoothPrinter() {
  // Check karein native app mein hain ya browser mein
  const isNative = window.Capacitor && window.Capacitor.isNativePlatform();
  
  if (isNative) {
    try {
      const { BluetoothLe } = window.Capacitor.Plugins;
      
      showToast('🔍 प्रिंटर खोजा जा रहा है...', 'info');
      
      await BluetoothLe.initialize({ mode: 'central' });
      
      // Sabhi BLE devices scan karein
      const device = await BluetoothLe.requestDevice({
        services: [],
        optionalServices: [
          '000018f0-0000-1000-8000-00805f9b34fb',
          '0000ff00-0000-1000-8000-00805f9b34fb',
          '49535343-fe7d-4ae5-8fa9-9fafd205e455',
          'e7810a71-73ae-499d-8c15-faa9aef0c3f2'
        ]
      });
      
      showToast('📡 कनेक्ट हो रहा है...', 'info');
      await BluetoothLe.connect({ deviceId: device.deviceId });
      
      // Services aur characteristics dhundein
      const services = await BluetoothLe.getServices({ deviceId: device.deviceId });
      let writeChar = null;
      let serviceUuid = null;
      
      for (const svc of services.services) {
        for (const ch of svc.characteristics) {
          if (ch.properties.write || ch.properties.writeWithoutResponse) {
            writeChar = ch.uuid;
            serviceUuid = svc.uuid;
            break;
          }
        }
        if (writeChar) break;
      }
      
      if (!writeChar) throw new Error('Printer write service nahi mili');
      
      // Global save karein
      window.nativePrinter = {
        deviceId: device.deviceId,
        serviceUuid: serviceUuid,
        writeChar: writeChar,
        BluetoothLe: BluetoothLe
      };
      
      document.getElementById('printer-status').textContent = '🖨️ Printer On';
      document.getElementById('printer-status').style.background = '#28a745';
      showToast('✅ प्रिंटर कनेक्ट हो गया!', 'success');
      
    } catch (err) {
      console.error(err);
      showToast('❌ प्रिंटर कनेक्ट नहीं हुआ: ' + err.message, 'error');
    }
    return;
  }
  
  // ===== BROWSER FALLBACK (Web Bluetooth) =====
  if (!navigator.bluetooth) {
    showToast('❌ Is browser mein Bluetooth nahi hai', 'error');
    return;
  }
  try {
    showToast('🔍 प्रिंटर खोजा जा रहा है...', 'info');
    bluetoothDevice = await navigator.bluetooth.requestDevice({
      acceptAllDevices: true,
      optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb', '0000ff00-0000-1000-8000-00805f9b34fb', '49535343-fe7d-4ae5-8fa9-9fafd205e455']
    });
    const server = await bluetoothDevice.gatt.connect();
    const services = await server.getPrimaryServices();
    for (const svc of services) {
      const chars = await svc.getCharacteristics();
      const wc = chars.find(c => c.properties.write || c.properties.writeWithoutResponse);
      if (wc) { bluetoothCharacteristic = wc; break; }
    }
    if (!bluetoothCharacteristic) throw new Error('Write characteristic nahi mili');
    document.getElementById('printer-status').textContent = '🖨️ Printer On';
    document.getElementById('printer-status').style.background = '#28a745';
    showToast('✅ प्रिंटर कनेक्ट हो गया!', 'success');
  } catch (error) {
    console.error(error);
    showToast('❌ प्रिंटर कनेक्ट नहीं हुआ', 'error');
  }
}
